# AgriN Connect v2 – Environment Variables

# HuggingFace API Token (required for LLM + vision features)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# HuggingFace Models (optional overrides)
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=ozair23/mobilenet_v2-1.0-224-finetuned-plantdisease

# Database (defaults to local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./agrin.db

# Interop HMAC secret (change in production!)
INTEROP_SECRET=agrin-dev-secret-change-in-prod

# Server config
HOST=0.0.0.0
PORT=8000
